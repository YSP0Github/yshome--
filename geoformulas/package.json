{
  "name": "geoformulas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "地震学公式推导与可视化知识站 —— 纯前端静态站点，无打包器、无后端",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gen-index": "node scripts/gen-index.mjs",
    "check": "npm run build && node scripts/selfcheck.mjs",
    "build": "node scripts/gen-index.mjs && tsc && node scripts/copy-assets.mjs",
    "watch": "tsc --watch",
    "serve": "node scripts/serve.mjs",
    "start": "node scripts/start.mjs"
  },
  "dependencies": {
    "katex": "^0.16.11"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
